# Application secrets for C:\Orion-Production\orion.env
# Copy to orion.env on the hosting machine and replace every REPLACE_ME value.
# PostgreSQL credentials are injected separately from the deployment .env file.
# GHCR credentials must NEVER be placed in this file.

# Discord developer portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=REPLACE_ME_DISCORD_BOT_TOKEN
GUILD_ID=1562411368458485820

# --- Access (matched by ID, never by role name) ---
OWNER_ID=985637303844225104
ADMIN_ROLE_ID=1570857006884065290
ADMIN_ROLE_NAME=Sect Admin
STAFF_ROLE_IDS=1562412567547224125
AFK_CHANNEL_NAME=Sleeping💤

# --- Localisation / presence ---
TIMEZONE=Africa/Lagos
BOT_STATUS=🔵Always forward. Always to win.

# --- Giveaways ---
# Leave empty to let Orion create /app/data/giveaway.key. Back up that named volume.
GIVEAWAY_ENCRYPTION_KEY=
GIVEAWAY_WINNER_ROLE_NAME=🏆 Giveaway Winner

# --- Key distribution ---
BETA_TESTER_ROLE_ID=0
BETA_CREATOR_ROLE_ID=0
BETA_KEYS_CHANNEL_ID=0
BETA_KEYS_PER_TESTER=3
BETA_KEYS_LOG_CHANNEL_ID=
BETA_KEYS_MANAGER_ROLE_IDS=

# --- Optional AI ticket handler ---
AI_PROVIDER=gemini
AI_API_KEY=REPLACE_ME_IF_USING_AI_OR_LEAVE_EMPTY
AI_MODEL=
AI_BASE_URL=

# --- Optional Twitch announcements ---
TWITCH_CLIENT_ID=REPLACE_ME_IF_USING_TWITCH_OR_LEAVE_EMPTY
TWITCH_CLIENT_SECRET=REPLACE_ME_IF_USING_TWITCH_OR_LEAVE_EMPTY
TWITCH_PING_ROLE_ID=0

# --- Optional music fallback ---
COOKIES_FILE=
AUTO_UPDATE_YTDLP=1
VOICE_DEBUG=0
