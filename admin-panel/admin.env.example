# Orion admin panel configuration. Copy to C:\Orion-Production\admin.env.
# Never commit real values.

# --- Where the panel listens ---
# Inside the container this must be 0.0.0.0; Compose publishes it on 127.0.0.1 only.
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080

# --- PostgreSQL (same database as the bot) ---
DATABASE_URL=postgresql://orion:REPLACE_ME_DB_PASSWORD@db:5432/orion
# Alternative: provide DB_HOST, DB_PORT, DB_USER, DB_NAME, DB_PASSWORD instead.

# --- Discord OAuth application ---
# Reuse your existing Orion application from
# https://discord.com/developers/applications (no new app needed).
# Add this redirect URI exactly: http://127.0.0.1:8081/auth/callback
# Client ID = Application ID; Client Secret is under OAuth2 -> General.
# The bot token is never used by this service.
DISCORD_CLIENT_ID=REPLACE_ME_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_ME_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=http://127.0.0.1:8081/auth/callback

# --- Who may sign in ---
ADMIN_GUILD_ID=1562411368458485820
ADMIN_OWNER_ID=985637303844225104
ADMIN_ROLE_IDS=1570857006884065290
STAFF_ROLE_IDS=1562412567547224125

# --- Session / API security ---
# Use a long random value (32+ characters).
SESSION_SECRET=REPLACE_ME_32_PLUS_CHARACTER_SESSION_SECRET
SESSION_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8081
# Optional bearer token for scripts. Leave empty to disable bearer auth.
ADMIN_API_TOKEN=

# --- Bot RPC (internal Docker network only) ---
# Must match BOT_RPC_TOKEN in C:\Orion-Production\.env.
BOT_RPC_URL=http://bot:8082
BOT_RPC_TOKEN=REPLACE_ME_SAME_64_CHARACTER_INTERNAL_RPC_TOKEN

# --- Docker control ---
DOCKER_SOCKET=/var/run/docker.sock
COMPOSE_PROJECT=orion
# Mounted read-only in Compose.
BACKUPS_DIR=/backups

# Full database writes are enabled by default. Set false for a read-only panel.
ADMIN_ALLOW_WRITES=true
