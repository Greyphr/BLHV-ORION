# Discord developer portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=paste-bot-token-here
# Blue Heaven server (already the default; only set this to run Orion in another server)
GUILD_ID=1562411368458485820
# Any strong password; used by the bundled Postgres container. Any characters are fine.
# NOTE: it is only read when the database is first created. Changing it later does not change the stored password.
DB_PASSWORD=change-me-to-something-long

# ---- Access (matched by ID, never by role name) ----
# The Sect Patriarch always has full access, even if the admin role changes.
OWNER_ID=985637303844225104
# Sect Admin role: full management access (XP, setup, config, tickets, announcements ...)
ADMIN_ROLE_ID=1570857006884065290
ADMIN_ROLE_NAME=Sect Admin
# Always-on staff roles (comma-separated): all staff commands + they can work tickets.
# More can be added in /admin -> Staff access.
STAFF_ROLE_IDS=1562412567547224125

# ---- Optional overrides (defaults shown) ----
AFK_CHANNEL_NAME=Sleeping💤
# Daily / weekly / monthly resets and event times. Nigeria = Africa/Lagos (WAT, UTC+1, no daylight saving).
TIMEZONE=Africa/Lagos
BOT_STATUS=🔵Always forward. Always to win.

# Giveaway rewards (gift-card codes etc.) are encrypted before they are stored. Leave this empty and the bot creates and
# keeps its own key in data/giveaway.key. BACK THAT FILE UP: without it stored codes can never be read again.
GIVEAWAY_ENCRYPTION_KEY=
GIVEAWAY_WINNER_ROLE_NAME=🏆 Giveaway Winner

# ---- Key distribution (/keys, /givekeys ...). Optional: leave the role IDs at 0 and /keys says it isn't set up ----
BETA_TESTER_ROLE_ID=0
BETA_CREATOR_ROLE_ID=0
BETA_KEYS_CHANNEL_ID=0
BETA_KEYS_PER_TESTER=3
BETA_KEYS_LOG_CHANNEL_ID=
BETA_KEYS_MANAGER_ROLE_IDS=

# ---- EXPERIMENTAL: AI ticket handler. Leave AI_API_KEY empty and it can't be turned on (then use /ai switch on). ----
# (AI_PROVIDER: gemini, anthropic or openai.)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Twitch live announcements (optional). Create an app at https://dev.twitch.tv/console/apps
# (OAuth Redirect URL: http://localhost, Category: Application Integration), then copy the Client ID and
# generate a Client Secret. Leave empty to keep Twitch announcements off.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_PING_ROLE_ID=0

# Music (optional). Only if YouTube starts refusing to play videos: export a Netscape-format cookies.txt, put it in
# data/ and point at it. Keep it private, it is a login session.
COOKIES_FILE=
AUTO_UPDATE_YTDLP=1
VOICE_DEBUG=0
