# Deployment-only configuration for C:\Orion-Production\.env
# Copy to .env on the hosting machine and replace every REPLACE_ME value.
# This file is never read by the Orion application container except for the
# PostgreSQL values explicitly injected by Compose.

# --- PostgreSQL ---
POSTGRES_DB=orion
POSTGRES_USER=orion
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_PASSWORD

# --- GHCR / GitHub ---
# Lower-case GitHub account that owns the private GHCR package.
GHCR_OWNER=REPLACE_ME_GITHUB_USERNAME
# Account used by WUD and by docker login on the host.
GHCR_USERNAME=REPLACE_ME_GITHUB_USERNAME
# Classic PAT with ONLY read:packages. Never use a write-capable token here.
GHCR_TOKEN=ghp_REPLACE_ME_READ_ONLY_PACKAGES_TOKEN
GITHUB_REPOSITORY=REPLACE_ME_GITHUB_USERNAME/BLHV-ORION

# First release to deploy, without the leading v. Example: release v1.0.0 -> 1.0.0.
# After WUD takes over it rewrites the image line in compose.yaml to newer numeric tags.
ORION_IMAGE_TAG=REPLACE_ME_FIRST_RELEASE_VERSION

# --- Notifications ---
# Create a Discord incoming webhook and paste its full HTTPS URL here.
DEPLOY_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME_WEBHOOK_ID/REPLACE_ME_WEBHOOK_TOKEN

# --- Update policy (keep false for the verified first deployment) ---
# Set to true only after the first manual deployment has been verified.
WUD_AUTO_UPDATE=false
# Health-gated rollback restores the whole Compose project. It does NOT revert database schema.
WUD_ROLLBACK_ENABLED=false
WUD_CHECK_CRON=0 */6 * * *
WUD_ROLLBACK_WINDOW_MS=180000
WUD_ROLLBACK_INTERVAL_MS=10000
WUD_ROLLBACK_GRACE_MS=15000

# --- Maintenance ---
BACKUP_RETENTION_DAYS=14
TZ=Africa/Lagos
